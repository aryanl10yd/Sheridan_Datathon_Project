# Optional OpenAI-compatible endpoint serving IBM Granite. Missing settings => DEMO mode.
# Never commit credentials. Set an endpoint controlled by your organization.
GRANITE_ENDPOINT=
GRANITE_MODEL=ibm-granite/granite-3.3-8b-instruct
GRANITE_API_KEY=tvbgQoAvUrAmg7Uzuq5spg2OtdnXE3lZt4x0ve553oVA
GRANITE_TIMEOUT_SECONDS=20
GRANITE_MAX_TOKENS=600
GRANITE_TEMPERATURE=0
GRANITE_RETRIES=1
# Analytical CSV directory; absent files are explicitly reported.
SENTINEL_DATA_DIR=./datasets
# Interlock credentials are configured separately in .env.interlock.
